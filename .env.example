# Copy this file to ".env" (same directory) and fill in values.
# The backend auto-loads .env on startup; real OS environment variables override it.
# .env is git-ignored — never commit real secrets.

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/devsleuth
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=winpostgres

# GitHub OAuth (for user login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (for webhook + API access)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# AI / LLM
AI_API_KEY=
AI_PROVIDER=openai

# Static Analyzer
STATIC_ANALYZER_PATH=/usr/local/bin/semgrep

# Encryption key for sensitive columns at rest (GitHub tokens). Any non-empty string.
ENCRYPTION_KEY=
# Set to true when serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false

# Server
SERVER_PORT=8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
